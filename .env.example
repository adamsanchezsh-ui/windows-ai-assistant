# === AI Providers ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=

# Primary / fallback order (comma-separated)
PRIMARY_MODEL=openai:gpt-4o
FALLBACK_MODELS=anthropic:claude-3-5-sonnet,xai:grok-beta

# Local / OpenAI-compatible
LOCAL_API_BASE=http://localhost:11434/v1
LOCAL_API_KEY=

# === App ===
APP_SECRET_KEY=change-me-to-a-long-random-string
DEFAULT_LANGUAGE=cs
DEFAULT_VOICE=cs

# === Features ===
ENABLE_VISION=true
ENABLE_VOICE=true
ENABLE_WEB_SEARCH=true
ENABLE_MEMORY=false

# === Paths ===
DATA_DIR=./data
LOG_DIR=./logs
QUARANTINE_DIR=./data/quarantine
