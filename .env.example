# === CYPHERpc AI Providers ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=

# Primary + fallback (comma-separated provider:model)
PRIMARY_MODEL=openai:gpt-4o
FALLBACK_MODELS=anthropic:claude-3-5-sonnet,xai:grok-beta,openai:gpt-4o-mini

# Task-specific models (optional overrides)
MODEL_QUICK=openai:gpt-4o-mini
MODEL_CODING=openai:gpt-4o
MODEL_REASONING=anthropic:claude-3-5-sonnet
MODEL_VISION=openai:gpt-4o

# Local / OpenAI-compatible (Ollama, LM Studio…)
LOCAL_API_BASE=http://localhost:11434/v1
LOCAL_API_KEY=

# App
APP_SECRET_KEY=change-me-to-a-long-random-string
DEFAULT_LANGUAGE=cs

# Features
ENABLE_VISION=true
ENABLE_VOICE=true
ENABLE_WEB_SEARCH=true
ENABLE_MEMORY=false
ENABLE_WAKE_WORD=false

# Paths
DATA_DIR=./data
LOG_DIR=./logs
QUARANTINE_DIR=./data/quarantine

# API usage limits (0 = unlimited)
API_DAILY_LIMIT=0
